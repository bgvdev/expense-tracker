# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Expense Tracker"
APP_ENV=local                        # local | staging | production
APP_KEY=                             # Run: php artisan key:generate
APP_DEBUG=false                      # NEVER true in production
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000   # Used in email links — set to Vercel URL in production

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. There is deliberately no
# production default — if this is unset, no cross-origin request is allowed.
CORS_ALLOWED_ORIGINS=http://localhost:13000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Token lifetime in minutes (default 10080 = 7 days). Tokens live in the
# browser's localStorage, so this must stay finite.
SANCTUM_TOKEN_EXPIRATION=10080
# Requests per minute per authenticated user on every /api route.
API_RATE_LIMIT=120

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db                           # 'db' for Docker; hostname for cloud provider
DB_PORT=5432
DB_DATABASE=expense_tracker
DB_USERNAME=laravel
DB_PASSWORD=                         # Required — no default
DB_SSLMODE=prefer                    # Use 'require' for Neon / cloud providers
DATABASE_URL=                        # Optional: full DSN (e.g. from Neon/Render dashboard)

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false          # Set true in production (HTTPS)

# ── Cache / Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug                      # Use 'error' in production

# ── Mail (Gmail SMTP) ─────────────────────────────────────────────────────────
# Use Gmail SMTP with an App Password (NOT your Gmail login password).
# Generate one at: Google Account → Security → 2-Step Verification → App Passwords
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=                       # Your Gmail address e.g. you@gmail.com
MAIL_PASSWORD=                       # 16-char App Password from Google
MAIL_FROM_ADDRESS=                   # Same Gmail address
MAIL_FROM_NAME="${APP_NAME}"

# ── Seeding ───────────────────────────────────────────────────────────────────
# Set true in local/staging to seed test@example.com / password.
# Must be false (or absent) in production.
# Note: default categories (CategorySeeder) are ALWAYS seeded by the entrypoint,
# regardless of this flag — this only gates the test user.
SEED_TEST_USER=true

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Leave empty to disable error reporting (local dev). Set in Render for prod.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── AWS / S3 (unused — placeholder from Laravel scaffold) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Redis (unused — placeholder) ──────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
