# ── BACKEND_URL — REQUIRED for production builds ──────────────────────────────
# The proxy destination for the /api/* rewrite in next.config.ts. This is the
# variable that actually matters: src/lib/api.ts uses relative URLs only, so all
# traffic goes through the rewrite.
#
# It is read at BUILD time and baked into the build output, so it must be set as
# a build-time variable (Vercel env var / Docker --build-arg) — setting it only
# at runtime has no effect. A production build with it unset now fails loudly
# rather than silently proxying to the production backend.
#
# Local (standalone):  http://localhost:8000
# Local (Docker):      http://api:8000   (set in docker-compose.yml)
# Production:          https://expense-tracker-singapore.onrender.com
BACKEND_URL=http://localhost:8000

# Not read by any application code — kept only for reference. Do not add new
# usages: the frontend must keep calling relative /api/* paths so that the
# browser only ever talks to its own origin (no CORS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Leave empty to disable error reporting (local dev). Set in Vercel for prod.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — uploads source maps from CI/Vercel. Never commit a real value.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
