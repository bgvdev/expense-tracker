# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Expense Tracker"
APP_ENV=local                        # local | staging | production
APP_KEY=                             # Run: php artisan key:generate
APP_DEBUG=false                      # NEVER true in production
APP_URL=http://localhost:8000

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated Sanctum stateful domains (exclude https://, just the hostname)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db                           # 'db' for Docker; hostname for cloud provider
DB_PORT=5432
DB_DATABASE=expense_tracker
DB_USERNAME=laravel
DB_PASSWORD=                         # Required — no default
DB_SSLMODE=prefer                    # Use 'require' for Neon / cloud providers
DATABASE_URL=                        # Optional: full DSN (e.g. from Neon/Render dashboard)

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false          # Set true in production (HTTPS)

# ── Cache / Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug                      # Use 'error' in production

# ── Mail ──────────────────────────────────────────────────────────────────────
# 'log' driver writes emails to storage/logs/laravel.log — safe for local dev
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Seeding ───────────────────────────────────────────────────────────────────
# Set true in local/staging to seed test@example.com / password.
# Must be false (or absent) in production.
SEED_TEST_USER=true

# ── AWS / S3 (unused — placeholder from Laravel scaffold) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Redis (unused — placeholder) ──────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
