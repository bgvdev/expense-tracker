# ══════════════════════════════════════════════════════════════════════════════
# Root .env — read by DOCKER COMPOSE ONLY
# ══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env
#
# Docker Compose interpolates ${VARIABLES} in docker-compose.yml from THIS file
# and only this file. It does NOT read backend/.env for interpolation, so
# DB_PASSWORD must be set here — `docker compose up` fails immediately with
# "DB_PASSWORD must be set in .env" otherwise.
#
# backend/.env is separate: it configures Laravel when running the backend
# standalone (php artisan serve). Under Docker, the api service receives its
# configuration from the `environment:` block in docker-compose.yml instead.
#
# This file is gitignored. Never commit real credentials.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=false
# REQUIRED. Generate with:  docker compose run --rm api php artisan key:generate --show
APP_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=expense_tracker
DB_USERNAME=laravel
# REQUIRED — compose fails fast if this is unset.
DB_PASSWORD=

# ── Host port mappings ────────────────────────────────────────────────────────
# Deliberately off the defaults (5432/8000/3000) so this stack can run alongside
# others on the same machine. Container-internal ports are unaffected.
DB_HOST_PORT=15432
API_HOST_PORT=18000
WEB_HOST_PORT=13000

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Must match the browser origin, i.e. WEB_HOST_PORT above. There is no
# production default: if unset, no cross-origin request is allowed.
CORS_ALLOWED_ORIGINS=http://localhost:13000

# ── Seeding ───────────────────────────────────────────────────────────────────
# Seeds test@example.com / password. Never set true in production.
SEED_TEST_USER=true
