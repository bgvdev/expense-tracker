# Backend API base URL (no trailing slash)
# Production:  https://expense-tracker-funw.onrender.com
# Local Docker: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Leave empty to disable error reporting (local dev). Set in Vercel for prod.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — uploads source maps from CI/Vercel. Never commit a real value.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
